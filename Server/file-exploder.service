[Unit]
Description=FileExploder - Remote File Operation Queue Manager
After=network.target
# Without a limit the unit restarts every RestartSec forever: the default burst
# is 5 starts within 10s, which one start per 5s never reaches, so a daemon that
# cannot start at all (a corrupt queue.db, say) loops silently and `systemctl
# --user status` never shows it as failed. Give up after five tries in five
# minutes so the failure is visible.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.local/bin/file-exploder daemon
Restart=on-failure
RestartSec=5
# The daemon finishes the job it is running before it exits, so a stop can
# legitimately take as long as that job. systemd's default stop timeout is 90s,
# which SIGKILLs a copy of any size - including on every `install.sh` upgrade,
# which stops the service first. Allow a longer wait; a job still running after
# it is killed, failed on the next start, and its staging reclaimed there, so
# no half-written destination is left behind either way.
TimeoutStopSec=5min
# No UMask here on purpose. The queue directory, log and lock file all set
# their own modes explicitly, while directories the daemon creates on the
# user's behalf are meant to honour the login default - a 0077 umask silently
# turned every "new folder" into a 0700 one.

[Install]
WantedBy=default.target
