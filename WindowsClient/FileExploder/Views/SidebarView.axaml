<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FileExploder.ViewModels"
             xmlns:views="using:FileExploder.Views"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="FileExploder.Views.SidebarView"
             x:DataType="vm:ConnectionViewModel">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <Grid Grid.Row="0" Margin="12,8" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="サーバー" FontWeight="Bold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Name="AddButton" Classes="borderless" Content="＋" FontWeight="Bold" />
        </Grid>
        <Separator Grid.Row="1" />

        <ListBox Grid.Row="2" Name="ServerList" Background="Transparent">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="views:ServerRowItem">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4">
                        <TextBlock Grid.Column="0" Text="🖴" Margin="0,0,8,0" VerticalAlignment="Center"
                                   Foreground="{Binding IsConnected, Converter={x:Static views:Converters.BoolToConnectedBrush}}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Server.Name}" />
                            <TextBlock FontSize="11" Foreground="Gray">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0}@{1}">
                                        <Binding Path="Server.Username" />
                                        <Binding Path="Server.Hostname" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                        <Ellipse Grid.Column="2" Width="8" Height="8" VerticalAlignment="Center"
                                 IsVisible="{Binding IsConnected}" Fill="Green" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="ContextMenu">
                        <ContextMenu>
                            <MenuItem Header="編集" Click="OnEditServerClick" />
                            <Separator />
                            <MenuItem Header="削除" Click="OnDeleteServerClick" />
                        </ContextMenu>
                    </Setter>
                </Style>
            </ListBox.Styles>
        </ListBox>

        <StackPanel Grid.Row="3" Margin="12,8" Orientation="Horizontal" Spacing="8"
                    IsVisible="{Binding IsConnecting}">
            <TextBlock Text="接続中..." Foreground="Gray" />
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="12,8" Orientation="Horizontal" Spacing="8"
                    IsVisible="{Binding ConnectionError, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding ConnectionError}" Foreground="Red" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
